<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Saved Weather"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etEditLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"/>

        <EditText
            android:id="@+id/etEditTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Temperature"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etEditCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Weather condition"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etEditHumidity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Humidity"
            android:inputType="number"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etEditWind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wind speed"
            android:inputType="numberDecimal"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvEditUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit:"
            android:textSize="18sp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/tvEditSavedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved:"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Record"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Record"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>